{
  "listen": ":7863",
  "api_key": "your-api-key-here",
  "api_keys": [
    {"key": "your-cn-key-here", "region": "cn", "name": "cn"},
    {"key": "your-global-key-here", "region": "global", "name": "global"}
  ],
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "server": {
    "max_body_mb": 32
  },
  "protocol": {
    "default_model": "deepseek-v4.1-flash",
    "model_mapping": {
      "claude-sonnet-4-5": "deepseek-v4.1-flash",
      "claude-opus-4-1": "glm-5.2",
      "gpt-5-codex": "deepseek-v4.1-flash"
    }
  },
  "cooldown": {
    "soft_rate": "600s",
    "soft_rate_max": "2h"
  },
  "schedule": {
    "checkin_hours": [9, 21],
    "travel_hours": [9, 21],
    "activity_hours": [10],
    "keepalive_hours": [22],
    "checkin_enabled": true,
    "travel_enabled": true,
    "activity_enabled": true,
    "keepalive_enabled": true
  },
  "upstream": {
    "timeout_seconds": 120,
    "header_timeout_seconds": 120,
    "idle_timeout_seconds": 300,
    "user_agent": "",
    "client_version": "",
    "cli_version": "",
    "device_token": "",
    "device_token_file": "",
    "client_name": "",
    "passthrough_ip": false
  },
  "features": {
    "sanitize_blacklist_fingerprints": true
  },
  "prompt": {
    "mode": "custom",
    "file": ""
  },
  "upstash": {
    "url": "",
    "token": ""
  },
  "pool": {
    "max_in_flight": 3,
    "breaker_threshold": 3,
    "breaker_cooldown": "30m",
    "breaker_cooldown_max": "6h",
    "idle_weight_per_hour": 0.5,
    "idle_weight_max": 5.0
  },
  "session_sticky": {
    "enabled": true,
    "ttl": "30m",
    "gc_interval": "5m"
  }
}
